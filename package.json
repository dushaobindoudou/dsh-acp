{
  "name": "dsh-acp-server",
  "version": "0.8.0",
  "description": "Agent Client Protocol (ACP) server plugin for the DeepSeek Harness (dsh) — drive dsh agents from Zed and any ACP client",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dushaobindoudou/dsh-acp.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent-client-protocol",
    "acp",
    "zed",
    "coding-agent",
    "cordis-plugin"
  ],
  "bin": {
    "dsh-acp-server": "bin/dsh-acp.mjs"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./test/mock-llm": {
      "types": "./lib/test/mock-llm.d.ts",
      "default": "./lib/test/mock-llm.js"
    },
    "./package.json": "./package.json",
    "./serve-startup": {
      "types": "./lib/serve-startup.d.ts",
      "default": "./lib/serve-startup.js"
    }
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "webui.html"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf lib",
    "test": "npm run build && node --test \"test/unit/*.test.mjs\"",
    "test:e2e": "node test/e2e/e2e.test.mjs && node test/e2e/serve.test.mjs && node test/e2e/webacp.test.mjs && node test/e2e/web-bare.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run clean && npm run build",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-attachment": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-brand": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^3.25.0",
    "commander": "^15.0.0",
    "@deepseek-ai/dsh-cmdline": "^0.1.0-rc.6",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.6",
    "@types/node": "^24",
    "typescript": "^5.6"
  },
  "homepage": "https://github.com/dushaobindoudou/dsh-acp#readme",
  "bugs": {
    "url": "https://github.com/dushaobindoudou/dsh-acp/issues"
  }
}
