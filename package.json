{
  "name": "dsh-acp-server",
  "version": "0.14.2",
  "description": "Agent Client Protocol (ACP) server plugin for the DeepSeek Harness (dsh) — drive dsh agents from Zed and any ACP client",
  "icon": "./icon.svg",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dushaobindoudou/dsh-acp.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent-client-protocol",
    "acp",
    "zed",
    "coding-agent",
    "cordis-plugin"
  ],
  "bin": {
    "dsh-acp-server": "bin/dsh-acp.mjs"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./test/mock-llm": {
      "types": "./lib/test/mock-llm.d.ts",
      "default": "./lib/test/mock-llm.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./serve-startup": {
      "types": "./lib/serve-startup.d.ts",
      "default": "./lib/serve-startup.js"
    }
  },
  "files": [
    "lib",
    "bin",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "webui.html"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf lib",
    "test": "npm run build && node --test \"test/unit/*.test.mjs\"",
    "test:e2e": "node test/e2e/e2e.test.mjs && node test/e2e/run-cli.test.mjs && node test/e2e/serve.test.mjs && node test/e2e/webacp.test.mjs && node test/e2e/web-bare.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run clean && npm run build",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.5",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-api-settings-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-workspace-files": "0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-brand": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-cmdline": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-host-directory-picker-browse": "0.2.0-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session-query": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-timeout": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "commander": "^15.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-tool-todo": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.2.0-rc.2",
    "@types/node": "^24",
    "typescript": "^5.6"
  },
  "homepage": "https://github.com/dushaobindoudou/dsh-acp#readme",
  "bugs": {
    "url": "https://github.com/dushaobindoudou/dsh-acp/issues"
  }
}
